# OSINT Platform Config
APP_ENV=development
AUTO_CREATE_DB=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Collector API keys
SHODAN_API_KEY=your_shodan_key_here
CENSYS_API_ID=your_censys_id_here
CENSYS_API_SECRET=your_censys_secret_here
HUNTER_API_KEY=your_hunter_key_here
GROQ_API_KEY=your_groq_key_here
SERPER_API_KEY=your_serper_key_here
WHOXY_API_KEY=your_whoxy_key_here
NVD_API_KEY=your_nvd_key_here
GITHUB_TOKEN=your_github_token_here
TG_API_ID=your_telegram_api_id_here
TG_API_HASH=your_telegram_api_hash_here
TG_SESSION_STRING=your_telegram_session_string_here

# No API keys needed for these collectors:
#   xposedornot_breach — free, no key (https://xposedornot.com/api)
#   holehe — free, no key (pip install holehe)
#   maigret — free, no key (pip install maigret)
#   crtsh — free, no key
#   dns_resolver — free, no key (dnspython)
#   simple_username_profiler — free, no key

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/osint_platform

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# API Security
API_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-different-random-string

# Optional first-admin bootstrap (set all three together; never commit real values)
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

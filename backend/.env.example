# OSINT Platform Config
APP_ENV=development
AUTO_CREATE_DB=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Collector API keys
SHODAN_API_KEY=your_shodan_key_here
CENSYS_API_ID=your_censys_id_here
CENSYS_API_SECRET=your_censys_secret_here
HUNTER_API_KEY=your_hunter_key_here
HIBP_API_KEY=your_hibp_key_here
GROQ_API_KEY=your_groq_key_here
SERPER_API_KEY=your_serper_key_here
WHOXY_API_KEY=your_whoxy_key_here
NVD_API_KEY=your_nvd_key_here
GITHUB_TOKEN=your_github_token_here
BUILTWITH_API_KEY=your_builtwith_key_here
EMAILREP_API_KEY=your_emailrep_key_here
SNUSBASE_API_KEY=your_snusbase_key_here
TG_API_ID=your_telegram_api_id_here
TG_API_HASH=your_telegram_api_hash_here
TG_SESSION_STRING=your_telegram_session_string_here
AHMIA_DEEP_SCRAPE=false

# Optional theHarvester providers
HACKERTARGET_API_KEY=
BUFFEROVERUN_API_KEY=
VT_API_KEY=
URLSCAN_API_KEY=
OTX_API_KEY=
LEAKIX_API_KEY=
DNSDUMPSTER_API_KEY=
SECURITYTRAILS_KEY=
FULLHUNT_API_KEY=
BEVIGIL_API_KEY=
TOMBA_API_KEY=
BRAVE_API_KEY=
DYMO_API_KEY=
NETLAS_API_KEY=
CRIMINALIP_API_KEY=
HUNTERHOW_API_KEY=
MOJEEK_API_KEY=
WINDVANE_API_KEY=
VENACUS_API_KEY=
ZOOMEYE_API_KEY=

# Optional paid theHarvester providers
INTELX_API_KEY=
ONYPHE_API_KEY=
FOFA_API_KEY=
SHERLOCKEYE_API_KEY=
PENTESTTOOLS_API_KEY=
PROJECTDISCOVERY_KEY=
ROCKETREACH_API_KEY=
SECURITYSCORECARD_KEY=
WHOISXML_API_KEY=
DEHASHED_API_KEY=
LEAKLOOKUP_API_KEY=

# No API keys needed for these collectors:
#   xposedornot_breach — free, no key (https://xposedornot.com/api)
#   holehe — free, no key (pip install holehe)
#   maigret — free, no key (pip install maigret)
#   crtsh — free, no key
#   dns_resolver — free, no key (dnspython)
#   simple_username_profiler — free, no key

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/osint_platform
SCREENSHOT_STORAGE_PATH=/app/data/screenshots

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# API Security
API_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-different-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional first-admin bootstrap (set all three together; never commit real values)
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
